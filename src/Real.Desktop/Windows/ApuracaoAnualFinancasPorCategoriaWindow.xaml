<Window
    x:Class="Real.Windows.ApuracaoAnualFinancasPorCategoriaWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Real.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Real.Models;assembly=Real.DomainModel"
    xmlns:system="clr-namespace:System;assembly=System.Xaml.Extensions"
    xmlns:viewModels="clr-namespace:Real.Models"
    Title="Apuração Anual de Finanças por Categoria"
    Width="1200"
    Height="450"
    Loaded="Window_Loaded"
    Unloaded="Window_Unloaded"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <CollectionViewSource x:Key="categoriasViewSource" d:DesignSource="{d:DesignInstance {x:Type viewModels:ApuracaoCategoriaModel}, CreateList=True}" />
            <CollectionViewSource x:Key="financasViewSource" Source="{Binding Financas, Source={StaticResource categoriasViewSource}}" />
            <!--<CollectionViewSource x:Key="recursoTiposViewSource" d:DesignSource="{d:DesignInstance {x:Type contas:ContaRecursoTipo}, CreateList=False}" />-->
            <Image x:Key="Magnifier" Source="/Resources/Images/magnifier_16xLG.png" />
            <Image x:Key="Save" Source="/Resources/Images/saveHS.png" />
            <Image x:Key="SaveAll" Source="/Resources/Images/saveAllHS.png" />
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Menu VerticalAlignment="Top">
            <MenuItem AutomationProperties.AutomationId="registroMenuItem" Header="Registro">
                <MenuItem Header="Nova Categoria ..." />
                <Separator />
                <MenuItem Header="Salvar" InputGestureText="Ctrl+S" />
                <Separator />
                <MenuItem Header="Fechar" />
            </MenuItem>
        </Menu>
        <ToolBar Grid.Row="1">
            <Button x:Name="novaCategoriaButton" Click="novaCategoriaButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Nova Categoria" />
                </StackPanel>
            </Button>
            <Separator />
            <Button
                x:Name="saveButton"
                Height="24"
                Click="SaveButton_Click"
                Content="{StaticResource Save}"
                ToolTip="Salvar" />
            <Separator />
            <Label>Ano</Label>
            <TextBox
                x:Name="anoTextBox"
                Width="50"
                Margin="5,0,0,0"
                AutomationProperties.AutomationId="anoTextBox"
                AutomationProperties.Name="anoTextBox"
                KeyDown="anoTextBox_KeyDown"
                ToolTip="Ano" />
            <Button
                x:Name="buscarButton"
                Height="24"
                Click="BuscarButton_Click"
                Content="{StaticResource Magnifier}"
                ToolTip="Buscar" />
            <Separator />
            <RadioButton
                x:Name="resumoRadioButton"
                Checked="resumoRadioButton_Checked"
                Content="Resumo"
                GroupName="ModoVisualizacao"
                IsChecked="True" />
            <RadioButton
                x:Name="detalheRadioButton"
                Checked="detalheRadioButton_Checked"
                Content="Detalhe"
                GroupName="ModoVisualizacao" />
            <Separator />
            <RadioButton
                x:Name="padraoRadioButton"
                Checked="padraoRadioButton_Checked"
                Content="Padrao"
                GroupName="Ordem"
                IsChecked="True" />
            <RadioButton
                x:Name="decrescenteRadioButton"
                Checked="decrescenteRadioButton_Checked"
                Content="Decrescente"
                GroupName="Ordem" />
            <Separator />
            <RadioButton
                x:Name="competenciaRadioButton"
                Checked="competenciaRadioButton_Checked"
                Content="Competencia"
                GroupName="RegimeApuracao"
                IsChecked="True" />
            <RadioButton
                x:Name="caixaRadioButton"
                Checked="caixaRadioButton_Checked"
                Content="Caixa"
                GroupName="RegimeApuracao" />
            <Separator />
            <ToggleButton
                x:Name="exibirButton"
                Content="TodasCategorias"
                IsChecked="{Binding ExibirTodasCategorias}" />
        </ToolBar>
        <Grid
            Grid.Row="2"
            Margin="0"
            DataContext="{StaticResource categoriasViewSource}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>
            <DataGrid
                x:Name="contaViewModelDataGrid"
                AutoGenerateColumns="False"
                AutomationProperties.Name="Grade de Contas"
                EnableRowVirtualization="False"
                ItemsSource="{Binding}"
                RowDetailsVisibilityMode="VisibleWhenSelected"
                VirtualizingPanel.IsVirtualizing="False">
                <!--<DataGrid.RowValidationRules>
                    <local:ContaValidationRule ValidationStep="UpdatedValue"/>
                </DataGrid.RowValidationRules>-->
                <DataGrid.Columns>
                    <DataGridTextColumn
                        x:Name="nomeColumn"
                        Width="*"
                        MinWidth="150"
                        AutomationProperties.Name="Nome da Categoria"
                        Binding="{Binding Nome}"
                        FontWeight="Bold"
                        Header="Nome">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#E1F5FE" />
                                                    <Setter Property="Foreground" Value="Black" />
                                                    <Setter Property="BorderBrush" Value="#E1F5FE" />
                                                    <Setter Property="BorderThickness" Value="0,0,1,0" />
                                                </Trigger>
                                                <Trigger Property="IsReadOnly" Value="True">
                                                    <Setter Property="Foreground" Value="Gray" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                            <StackPanel Background="{TemplateBinding Background}" Orientation="Horizontal">
                                                <TextBlock
                                                    Width="24"
                                                    Height="16"
                                                    VerticalAlignment="Center"
                                                    FontFamily="{StaticResource FontAwesomesSolid}"
                                                    FontSize="16"
                                                    Foreground="Black"
                                                    Text="{Binding IconFaUnicode}"
                                                    TextAlignment="Center" />
                                                <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                            </StackPanel>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                    <!--<DataGridCheckBoxColumn
                        x:Name="ativaColumn"
                        Width="50"
                        Binding="{Binding Ativa}"
                        Header="Ativa" />-->
                    <!--<DataGridTextColumn
                        x:Name="valorPrevistoAnualColumn"
                        Width="72"
                        Binding="{Binding ValorPrevistoAnual, StringFormat={}{0:n2}}"
                        CellStyle="{StaticResource RightStyle}"
                        Header="Anual (R$)" />
                    <DataGridTextColumn
                        x:Name="valorPrevistoMensalColumn"
                        Width="72"
                        Binding="{Binding ValorPrevistoMensal, StringFormat={}{0:n2}}"
                        CellStyle="{StaticResource RightStyle}"
                        Header="Mensal (R$)" />-->
                    <DataGridTextColumn
                        x:Name="valorJaneiroColumn"
                        MinWidth="72"
                        Binding="{Binding ValorJaneiro, StringFormat={}{0:n2}, Mode=OneWay}"
                        CellStyle="{StaticResource RightStyle}"
                        Header="Jan"
                        HeaderStyle="{StaticResource RightHeaderStyle}" />
                    <DataGridTextColumn
                        x:Name="valorFevereiroColumn"
                        MinWidth="72"
                        Binding="{Binding ValorFevereiro, StringFormat={}{0:n2}, Mode=OneWay}"
                        CellStyle="{StaticResource RightStyle}"
                        Header="Fev"
                        HeaderStyle="{StaticResource RightHeaderStyle}" />
                    <DataGridTextColumn
                        x:Name="valorMarcoColumn"
                        MinWidth="72"
                        Binding="{Binding ValorMarco, StringFormat={}{0:n2}, Mode=OneWay}"
                        CellStyle="{StaticResource RightStyle}"
                        Header="Mar"
                        HeaderStyle="{StaticResource RightHeaderStyle}" />
                    <DataGridTextColumn
                        x:Name="valorAbrilColumn"
                        MinWidth="72"
                        Binding="{Binding ValorAbril, StringFormat={}{0:n2}, Mode=OneWay}"
                        CellStyle="{StaticResource RightStyle}"
                        Header="Abr"
                        HeaderStyle="{StaticResource RightHeaderStyle}" />
                    <DataGridTextColumn
                        x:Name="valorMaioColumn"
                        MinWidth="72"
                        Binding="{Binding ValorMaio, StringFormat={}{0:n2}, Mode=OneWay}"
                        CellStyle="{StaticResource RightStyle}"
                        Header="Maio"
                        HeaderStyle="{StaticResource RightHeaderStyle}" />
                    <DataGridTextColumn
                        x:Name="valorJunhoColumn"
                        MinWidth="72"
                        Binding="{Binding ValorJunho, StringFormat={}{0:n2}, Mode=OneWay}"
                        CellStyle="{StaticResource RightStyle}"
                        Header="Jun"
                        HeaderStyle="{StaticResource RightHeaderStyle}" />
                    <DataGridTextColumn
                        x:Name="valorJulhoColumn"
                        MinWidth="72"
                        Binding="{Binding ValorJulho, StringFormat={}{0:n2}, Mode=OneWay}"
                        CellStyle="{StaticResource RightStyle}"
                        Header="Jul"
                        HeaderStyle="{StaticResource RightHeaderStyle}" />
                    <DataGridTextColumn
                        x:Name="valorAgostoColumn"
                        MinWidth="72"
                        Binding="{Binding ValorAgosto, StringFormat={}{0:n2}, Mode=OneWay}"
                        CellStyle="{StaticResource RightStyle}"
                        Header="Ago"
                        HeaderStyle="{StaticResource RightHeaderStyle}" />
                    <DataGridTextColumn
                        x:Name="valorSetembroColumn"
                        MinWidth="72"
                        Binding="{Binding ValorSetembro, StringFormat={}{0:n2}, Mode=OneWay}"
                        CellStyle="{StaticResource RightStyle}"
                        Header="Set"
                        HeaderStyle="{StaticResource RightHeaderStyle}" />
                    <DataGridTextColumn
                        x:Name="valorOutubroColumn"
                        MinWidth="72"
                        Binding="{Binding ValorOutubro, StringFormat={}{0:n2}, Mode=OneWay}"
                        CellStyle="{StaticResource RightStyle}"
                        Header="Out"
                        HeaderStyle="{StaticResource RightHeaderStyle}" />
                    <DataGridTextColumn
                        x:Name="valorNovembroColumn"
                        MinWidth="72"
                        Binding="{Binding ValorNovembro, StringFormat={}{0:n2}, Mode=OneWay}"
                        CellStyle="{StaticResource RightStyle}"
                        Header="Nov"
                        HeaderStyle="{StaticResource RightHeaderStyle}" />
                    <DataGridTextColumn
                        x:Name="valorDezembroColumn"
                        MinWidth="72"
                        Binding="{Binding ValorDezembro, StringFormat={}{0:n2}, Mode=OneWay}"
                        CellStyle="{StaticResource RightStyle}"
                        Header="Dez"
                        HeaderStyle="{StaticResource RightHeaderStyle}" />
                    <DataGridTextColumn
                        x:Name="valorAnoColumn"
                        MinWidth="72"
                        Binding="{Binding ValorTotal, StringFormat={}{0:n2}, Mode=OneWay}"
                        CellStyle="{StaticResource RightStyle}"
                        FontWeight="Bold"
                        Header="Total"
                        HeaderStyle="{StaticResource RightHeaderStyle}" />

                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />
            <GroupBox Grid.Column="3" Header="Categoria">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBox
                        x:Name="nomeTextBox"
                        Margin="5"
                        AutomationProperties.AutomationId="nomeTextBox"
                        AutomationProperties.Name="nomeTextBox"
                        Text="{Binding Nome}" />

                    <GroupBox Grid.Row="1" Header="Finanças">
                        <Grid>
                            <StackPanel>
                                <ToolBar VerticalAlignment="Top">
                                    <Button x:Name="novaFinancaButton" Content="Nova Finança..." />
                                </ToolBar>
                                <DataGrid
                                    Height="Auto"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    AutoGenerateColumns="False"
                                    EnableRowVirtualization="True"
                                    ItemsSource="{Binding Source={StaticResource financasViewSource}}"
                                    RowDetailsVisibilityMode="VisibleWhenSelected"
                                    RowValidationErrorTemplate="{Binding Source={StaticResource rowValidationErrorTemplate}}">
                                    <DataGrid.RowValidationRules>
                                        <DataErrorValidationRule ValidatesOnTargetUpdated="True" ValidationStep="UpdatedValue" />
                                    </DataGrid.RowValidationRules>
                                    <DataGrid.Columns>
                                        <!--<DataGridTextColumn
                                            Width="72"
                                            Binding="{Binding Id}"
                                            Header="Id" />
                                        <DataGridComboBoxColumn
                                            Width="72"
                                            Header="Tipo"
                                            ItemsSource="{Binding Source={system:EnumBindingSource {x:Type applicationModel:TipoFinancaEnum}}, Mode=OneWay}"
                                            SelectedValueBinding="{Binding TipoId}" />-->
                                        <DataGridTextColumn
                                            Width="Auto"
                                            Binding="{Binding Competencia, StringFormat={}{0:MM/yyyy}}"
                                            Header="Competência" />
                                        <DataGridTextColumn
                                            Width="Auto"
                                            Binding="{Binding Data, StringFormat={}{0:dd/MM/yyyy}}"
                                            Header="Data" />
                                        <DataGridTextColumn
                                            Width="*"
                                            Binding="{Binding Descricao}"
                                            Header="Descrição" />
                                        <DataGridTextColumn
                                            Width="72"
                                            Binding="{Binding Valor, StringFormat={}{0:n2}}"
                                            CellStyle="{StaticResource RightStyle}"
                                            Header="Valor (R$)" />
                                        <!--<DataGridTextColumn
                                            Width="72"
                                            Binding="{Binding State, Mode=OneWay}"
                                            Header="State" />-->
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </GroupBox>
        </Grid>
        <StatusBar Grid.Row="3" VerticalAlignment="Bottom">
            <Label x:Name="statusBarLabel" Content="Pronto." />
        </StatusBar>
    </Grid>
</Window>
