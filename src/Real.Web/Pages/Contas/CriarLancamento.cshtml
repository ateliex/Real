@page
@using Real.Helpers
@model Real.Pages.Contas.CriarLancamentoModel

@{
    ViewData["Title"] = "Criar Lançamento";
}

@section Breadcrumb {
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index"><i class="bi bi-house"></i></a></li>
            <li class="breadcrumb-item"><a asp-page="./Index">Contas</a></li>
            <li class="breadcrumb-item active" aria-current="page">Criar Lançamento</li>
        </ol>
    </nav>
}

@section Title {
    @ViewData["Title"] <span class="badge bg-secondary">Novo</span>
}

@section CardHeader {
    <ul class="nav nav-tabs card-header-tabs">
        <li class="nav-item">
            <a class="nav-link active" aria-current="page">
                <i class="bi bi-plus-circle"></i>
                Criar Lançamento
            </a>
        </li>
    </ul>
}

<div asp-validation-summary="All" class="text-danger"></div>
<div class="row mb-3">
    <label asp-for="Input.TipoLancamentoId" class="col-sm-3 col-form-label"></label>
    <div class="col-sm-9">
        <select asp-for="Input.TipoLancamentoId" class="form-select" asp-items="Html.GetEnumSelectList<TipoLancamentoEnum>()"></select>
        <span asp-validation-for="Input.TipoLancamentoId" class="text-danger"></span>
    </div>
</div>
<div class="row mb-3">
    <label asp-for="Input.ContaId" class="col-sm-3 col-form-label"></label>
    <div class="col-sm-9">
        <select asp-for="Input.ContaId" class="form-select" asp-items="ViewBag.ContaId"></select>
        <span asp-validation-for="Input.ContaId" class="text-danger"></span>
    </div>
</div>
<fieldset class="row mb-3">
    <legend class="col-form-label col-sm-3 pt-0">Tipo Competência</legend>
    <div class="col-sm-9">
        <div class="form-check">
            <input class="form-check-input" type="radio" name="Input.TipoCompetenciaId" id="Input_TipoCompetenciaId_Diaria" value="0">
            <label class="form-check-label" for="Input_TipoCompetenciaId_Diaria">
                Diária
            </label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="radio" name="Input.TipoCompetenciaId" id="Input_TipoCompetenciaId_Mensal" value="1">
            <label class="form-check-label" for="Input_TipoCompetenciaId_Mensal">
                Mensal
            </label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="radio" name="Input.TipoCompetenciaId" id="Input_TipoCompetenciaId_Anual" value="2">
            <label class="form-check-label" for="Input_TipoCompetenciaId_Anual">
                Anual
            </label>
        </div>
        <span asp-validation-for="Input.TipoCompetenciaId" class="text-danger"></span>
    </div>
</fieldset>
<div class="row mb-3">
    <label asp-for="Input.Data" class="col-sm-3 col-form-label"></label>
    <div class="col-sm-9">
        <input asp-for="Input.Data" class="form-control" />
        <span asp-validation-for="Input.Data" class="text-danger"></span>
    </div>
</div>
<div class="row mb-3">
    <label asp-for="Input.Descricao" class="col-sm-3 col-form-label"></label>
    <div class="col-sm-9">
        <input asp-for="Input.Descricao" class="form-control" />
        <span asp-validation-for="Input.Descricao" class="text-danger"></span>
    </div>
</div>
<div class="row mb-3">
    <label asp-for="Input.Valor" class="col-sm-3 col-form-label"></label>
    <div class="col-sm-9">
        <input asp-for="Input.Valor" class="form-control" />
        <span asp-validation-for="Input.Valor" class="text-danger"></span>
    </div>
</div>
<fieldset class="row mb-3">
    <legend class="col-form-label col-sm-3 pt-0">Tipo Finança</legend>
    <div class="col-sm-9">
        <div class="form-check">
            <input class="form-check-input" type="radio" name="Input.TipoFinancaId" id="Input_TipoFinancaId_Receita" value="0">
            <label class="form-check-label" for="Input_TipoFinancaId_Receita">
                Receita
            </label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="radio" name="Input.TipoFinancaId" id="Input_TipoFinancaId_Despesa" value="1">
            <label class="form-check-label" for="Input_TipoFinancaId_Despesa">
                Despesa
            </label>
        </div>
        <span asp-validation-for="Input.TipoFinancaId" class="text-danger"></span>
    </div>
</fieldset>
<div class="row mb-3">
    <label asp-for="Input.CategoriaId" class="col-sm-3 col-form-label"></label>
    <div class="col-sm-9">
        <select asp-for="Input.CategoriaId" class="form-select" asp-items="ViewBag.CategoriaId"></select>
        <span asp-validation-for="Input.CategoriaId" class="text-danger"></span>
    </div>
</div>
<div class="row mb-3">
    <div class="col-sm-9 offset-sm-3">
        <div class="form-check">
            <input type="checkbox" asp-for="Input.EhPrevisao" class="form-check-input" />
            <label asp-for="Input.EhPrevisao" class="form-check-label"></label>
        </div>
        <span asp-validation-for="Input.EhPrevisao" class="text-danger"></span>
    </div>
</div>
<div class="row mb-3">
    <div class="col-sm-9 offset-sm-3">
        <div class="form-check">
            <input type="checkbox" asp-for="Input.EhRecorrente" class="form-check-input" />
            <label asp-for="Input.EhRecorrente" class="form-check-label"></label>
        </div>
        <span asp-validation-for="Input.EhRecorrente" class="text-danger"></span>
    </div>
</div>

@section FormActions {
    <input type="hidden" asp-for="RefererUrl" />
    <button type="submit" value="Salvar" class="btn btn-primary">
        Salvar
    </button>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
