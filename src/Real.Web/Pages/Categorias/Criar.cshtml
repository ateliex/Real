@page
@model Real.Pages.Categorias.CriarModel

@{
    ViewData["Title"] = "Criar Categoria";
}

@section Breadcrumb {
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index"><i class="bi bi-house"></i></a></li>
            <li class="breadcrumb-item"><a asp-page="./Index">Categorias</a></li>
            <li class="breadcrumb-item active" aria-current="page">Criar</li>
        </ol>
    </nav>
}

@section Title {
    @ViewData["Title"] <span class="badge bg-secondary">Nova</span>
}

@section CardHeader {
    <ul class="nav nav-tabs card-header-tabs">
        <li class="nav-item">
            <a class="nav-link active" aria-current="page">
                <i class="bi bi-plus-circle"></i>
                Criar Nova
            </a>
        </li>
    </ul>
}

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row mb-3">
    <label asp-for="CadastroCategoria.Id" class="col-sm-3 col-form-label"></label>
    <div class="col-sm-9">
        <input asp-for="CadastroCategoria.Id" class="form-control" />
        <span asp-validation-for="CadastroCategoria.Id" class="text-danger"></span>
    </div>
</div>
<div class="row mb-3">
    <label asp-for="CadastroCategoria.Nome" class="col-sm-3 col-form-label"></label>
    <div class="col-sm-9">
        <input asp-for="CadastroCategoria.Nome" class="form-control" />
        <span asp-validation-for="CadastroCategoria.Nome" class="text-danger"></span>
    </div>
</div>
<div class="row mb-3">
    <div class="col-sm-9 offset-sm-3">
        <div class="form-check">
            <input type="checkbox" asp-for="CadastroCategoria.AplicaReceita" class="form-check-input" />
            <label asp-for="CadastroCategoria.AplicaReceita" class="form-check-label"></label>
        </div>
        <span asp-validation-for="CadastroCategoria.AplicaReceita" class="text-danger"></span>
    </div>
</div>
<div class="row mb-3">
    <div class="col-sm-9 offset-sm-3">
        <div class="form-check">
            <input type="checkbox" asp-for="CadastroCategoria.AplicaDespesa" class="form-check-input" />
            <label asp-for="CadastroCategoria.AplicaDespesa" class="form-check-label"></label>
        </div>
        <span asp-validation-for="CadastroCategoria.AplicaDespesa" class="text-danger"></span>
    </div>
</div>
<div class="row mb-3">
    <label asp-for="CadastroCategoria.Ordem" class="col-sm-3 col-form-label"></label>
    <div class="col-sm-9">
        <input asp-for="CadastroCategoria.Ordem" class="form-control" />
        <span asp-validation-for="CadastroCategoria.Ordem" class="text-danger"></span>
    </div>
</div>
<div class="row mb-3">
    <div class="col-sm-9 offset-sm-3">
        <div class="form-check">
            <input type="checkbox" asp-for="CadastroCategoria.Ativa" class="form-check-input" />
            <label asp-for="CadastroCategoria.Ativa" class="form-check-label"></label>
        </div>
        <span asp-validation-for="CadastroCategoria.Ativa" class="text-danger"></span>
    </div>
</div>

@section FormActions {
    <input type="hidden" asp-for="RefererUrl" />
    <button type="submit" value="Salvar" class="btn btn-primary">
        Salvar
    </button>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
