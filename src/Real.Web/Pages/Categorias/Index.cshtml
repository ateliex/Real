@page
@model IndexModel

@{
    ViewData["Title"] = "Categorias";

    var i = 0;

    var isCompacto = false;

    var isDebug = false;
}

@section Breadcrumb {
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index"><i class="bi bi-house"></i></a></li>
            <li class="breadcrumb-item active" aria-current="page">Categorias</li>
        </ol>
    </nav>
}

<form class="row row-cols-md-auto justify-content-md-center g-2 mb-3" method="get">
    <div action="col-12">
        <div class="input-group">
            <label asp-for="Competencia" class="input-group-text"></label>
            <input asp-for="Competencia" class="form-control" type="month" />
        </div>
    </div>
    <div class="col-12">
        <div class="btn-group" role="group" aria-label="Basic radio toggle button group">
            <input type="radio" class="btn-check" name="ModoVisualizacao" id="ModoVisualizacao_Tabela" value="1" @(Model.ModoVisualizacao == ModoVisualizacaoEnum.Tabela ? "checked" : "") autocomplete="off">
            <label class="btn btn-outline-primary" for="ModoVisualizacao_Tabela">Tabela</label>

            <input type="radio" class="btn-check" name="ModoVisualizacao" id="ModoVisualizacao_Lista" value="2" @(Model.ModoVisualizacao == ModoVisualizacaoEnum.Lista ? "checked" : "") autocomplete="off">
            <label class="btn btn-outline-primary" for="ModoVisualizacao_Lista">Lista</label>
        </div>
    </div>
    <div class="col-12">
        <div class="btn-group" role="group" aria-label="Basic radio toggle button group">
            <input type="radio" class="btn-check" name="Ordem" id="Ordem_Padrao" value="1" @(Model.Ordem == OrdemEnum.Padrao ? "checked" : "") autocomplete="off">
            <label class="btn btn-outline-primary" for="Ordem_Padrao">Padrão</label>

            <input type="radio" class="btn-check" name="Ordem" id="Ordem_Decrescente" value="2" @(Model.Ordem == OrdemEnum.Decrescente ? "checked" : "") autocomplete="off">
            <label class="btn btn-outline-primary" for="Ordem_Decrescente">Decrescente</label>
        </div>
    </div>
    <div class="col-12">
        <div class="btn-group" role="group" aria-label="Basic radio toggle button group">
            <input type="radio" class="btn-check" name="RegimeApuracao" id="RegimeApuracao_Competencia" value="1" @(Model.RegimeApuracao == RegimeApuracaoEnum.Competencia ? "checked" : "") autocomplete="off">
            <label class="btn btn-outline-primary" for="RegimeApuracao_Competencia">Competência</label>

            <input type="radio" class="btn-check" name="RegimeApuracao" id="RegimeApuracao_Caixa" value="2" @(Model.RegimeApuracao == RegimeApuracaoEnum.Caixa ? "checked" : "") autocomplete="off">
            <label class="btn btn-outline-primary" for="RegimeApuracao_Caixa">Caixa</label>
        </div>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-search"></i>
            Buscar
        </button>
    </div>
</form>

<div class="row row-cols-1 row-cols-md-3 justify-content-md-center g-4 mb-4">
    <form class="col d-flex align-items-start justify-content-evenly" method="get">
        <button type="submit" class="btn btn-secondary" name="Competencia" value="@Model.Competencia.Value.AddMonths(-1).ToString("yyyy-MM")">
            <i class="bi bi-arrow-left-circle"></i>
            Anterior
        </button>
        <button type="submit" class="btn btn-secondary" name="Competencia" value="@Model.Competencia.Value.AddMonths(1).ToString("yyyy-MM")">
            Próximo
            <i class="bi bi-arrow-right-circle"></i>
        </button>
        <input type="hidden" name="__Invariant" value="Competencia" />
        <input type="hidden" asp-for="ModoVisualizacao" />
        <input type="hidden" asp-for="Ordem" />
        <input type="hidden" asp-for="RegimeApuracao" />
    </form>
    <div class="col">
        <div class="card">
            <div class="card-header">
                Apuração
            </div>
            <div class="card-body">
                <h5 class="card-title">
                    @Html.DisplayFor(model => Model.Apuracao.Competencia)
                    <span class="badge @(Model.Apuracao.StatusId == StatusApuracaoEnum.Aberta ? "text-bg-warning" : "text-bg-success")"><i class="bi @(Model.Apuracao.StatusId == StatusApuracaoEnum.Aberta ? "bi-file-earmark-fill" : "bi-file-earmark-lock-fill")"></i></span>
                </h5>
                @if (Model.Apuracao.StatusId == StatusApuracaoEnum.Aberta)
                {
                    <p class="card-text">
                        A apuração deste mês está <b>aberta</b>.
                    </p>
                }
                else
                {
                    <p class="card-text">
                        A apuração deste mês está <b>fechada</b>.
                    </p>
                }
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between align-items-start">
                    <div class="ms-2 me-auto">
                        <div class="fw-bold text-primary">
                            @Html.DisplayNameFor(model => model.Apuracao.ValorReceitasTotal)
                        </div>
                    </div>
                    <span class="text-primary ValorReceitas">
                        @Html.DisplayFor(model => Model.Apuracao.ValorReceitasTotal)
                    </span>
                    &nbsp;(+)
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-start">
                    <div class="ms-2 me-auto">
                        <div class="fw-bold text-danger">
                            @Html.DisplayNameFor(model => model.Apuracao.ValorDespesasTotal)
                        </div>
                    </div>
                    <span class="text-danger ValorDespesas">
                        @Html.DisplayFor(model => Model.Apuracao.ValorDespesasTotal)
                    </span>
                    &nbsp;(+)
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-start border-top">
                    <div class="ms-2 me-auto">
                        <div class="fw-bold">
                            @Html.DisplayNameFor(model => model.Apuracao.ValorSaldoTotal)
                        </div>
                    </div>
                    <span class="fw-bold text-@(Model.Apuracao.ValorSaldoTotal < 0 ? "danger" : "primary") ValorSaldo">
                        @Html.DisplayFor(model => Model.Apuracao.ValorSaldoTotal)
                    </span>
                    &nbsp;(=)
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-start">
                    <div class="ms-2 me-auto">
                        <div class="fw-bold text-secondary">
                            @Html.DisplayNameFor(model => model.Apuracao.ValorAcumuladoAnterior)
                        </div>
                    </div>
                    <span class="text-@(Model.Apuracao.ValorAcumuladoAnterior < 0 ? "danger" : "primary") ValorSaldoAcumulado">
                        @Html.DisplayFor(model => Model.Apuracao.ValorAcumuladoAnterior)
                    </span>
                    &nbsp;(+)
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-start border-top">
                    <div class="ms-2 me-auto">
                        <div class="fw-bold">
                            @Html.DisplayNameFor(model => model.Apuracao.ValorAcumuladoTotal)
                        </div>
                    </div>
                    <span class="fw-bold text-@(Model.Apuracao.ValorAcumuladoTotal < 0 ? "danger" : "primary") ValorSaldoTotal">
                        @Html.DisplayFor(model => Model.Apuracao.ValorAcumuladoTotal)
                    </span>
                    &nbsp;(=)
                </li>
                @if (!string.IsNullOrEmpty(Model.Apuracao.Observacao))
                {
                    <li class="list-group-item d-flex justify-content-between align-items-start">
                        <div class="ms-2 me-auto">
                            <div class="fw-bold">
                                @Html.DisplayNameFor(model => model.Apuracao.Observacao)
                            </div>
                            @Html.DisplayFor(model => model.Apuracao.Observacao)
                        </div>
                    </li>
                }
            </ul>
            <div class="card-body">
                @if (Model.Apuracao.StatusId == StatusApuracaoEnum.Aberta)
                {
                    <a class="card-link text-decoration-none" asp-page="/Folhas/Fechar" asp-route-id="@Model.Apuracao.Id" target="_modal">
                        Fechar
                        <i class="bi bi-lock"></i>
                    </a>
                }
                else
                {
                    <a class="card-link text-decoration-none" asp-page="/Folhas/Reabrir" asp-route-id="@Model.Apuracao.Id" target="_modal">
                        Reabrir
                        <i class="bi bi-unlock"></i>
                    </a>
                }
                <a class="card-link text-decoration-none edicao" asp-page="/Folhas/Editar" asp-route-id="@Model.Apuracao.Id" target="_modal">
                    Editar
                    <i class="bi bi-pencil"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="col">
    </div>
</div>

@switch (Model.ModoVisualizacao)
{
    case ModoVisualizacaoEnum.Tabela:

        <div class="row row-cols-1 row-cols-md-1 justify-content-md-center g-4 mb-4">
            <div class="col">
                <div class="card">
                    <div class="card-header fw-bold text-primary">
                        Receitas
                    </div>
                    <div class="card-body p-0">
                        <form class="table-responsive text-nowrap" method="get">
                            <table class="table table-striped table-borderless align-middle mb-1">
                                <thead>
                                    <tr>
                                        <th>Nome</th>
                                        <th class="text-end valor">Total</th>
                                    </tr>
                                </thead>
                                <tbody class="table-group-divider">
                                    @foreach (var receita in Model.Receitas)
                                    {
                                        <tr class="Receita">
                                            <td class="text-overflow-ellipsis">
                                                @* <span class="ordem text-end text-secondary">
                                                    @i.ToString().
                                                </span> *@
                                                <i class="bi bi-@(receita.BiIcon)"></i>
                                                <span class="Nome">@receita.CategoriaNome</span>
                                            </td>
                                            <td class="text-end text-primary Total">@Html.DisplayFor(model => receita.Valor)</td>
                                        </tr>

                                        i++;
                                    }
                                </tbody>
                            </table>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card">
                    <div class="card-header fw-bold text-danger">
                        Despesas
                    </div>
                    <div class="card-body p-0">
                        <form class="table-responsive text-nowrap" method="get">
                            <table class="table table-striped table-borderless align-middle mb-1">
                                <thead>
                                    <tr>
                                        <th>Nome</th>
                                        <th class="text-end valor">Total</th>
                                    </tr>
                                </thead>
                                <tbody class="table-group-divider">
                                    @foreach (var despesa in Model.Despesas)
                                    {
                                        <tr class="Despesa">
                                            <td class="text-overflow-ellipsis">
                                                @* <span class="ordem text-end text-secondary">
                                                    @i.ToString().
                                                </span> *@
                                                <i class="bi bi-@(despesa.BiIcon)"></i>
                                                <span class="Nome">@despesa.CategoriaNome</span>
                                            </td>
                                            <td class="text-end text-danger Total">@Html.DisplayFor(model => despesa.Valor)</td>
                                        </tr>

                                        i++;
                                    }
                                </tbody>
                            </table>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        break;

    case ModoVisualizacaoEnum.Lista:

        <div class="row row-cols-1 row-cols-md-1 justify-content-md-center g-4 mb-4">
            <div class="col">
                <form class="text-nowrap" method="get">
                    <div class="card">
                        <div class="card-header fw-bold text-primary">
                            Receitas
                        </div>
                        <div class="card-body border-bottom d-flex">
                            <div class="card-text flex-grow-1"></div>
                            <div>
                                <button type="button" class="btn btn-outline-secondary" id="expandirTodasReceitas">
                                    <i class="bi bi-arrows-expand"></i>
                                    Expandir Todas
                                </button>
                                <button type="button" class="btn btn-outline-secondary" id="recolherTodasReceitas">
                                    <i class="bi bi-arrows-collapse"></i>
                                    Recolher Todas
                                </button>
                            </div>
                        </div>
                        <div class="accordion accordion-flush accordion-primary" id="receitasAccordion">
                            @foreach (var receita in Model.Receitas)
                            {
                                RenderLista(receita, i, "primary", isCompacto, isDebug);

                                i++;
                            }
                        </div>
                        <div class="card-footer">
                        </div>
                    </div>
                </form>
            </div>
            <div class="col">
                <form class="text-nowrap" method="get">
                    <div class="card">
                        <div class="card-header fw-bold text-danger">
                            Despesas
                        </div>
                        <div class="card-body border-bottom d-flex">
                            <div class="card-text flex-grow-1"></div>
                            <div>
                                <button type="button" class="btn btn-outline-secondary" id="expandirTodasDespesas">
                                    <i class="bi bi-arrows-expand"></i>
                                    Expandir Todas
                                </button>
                                <button type="button" class="btn btn-outline-secondary" id="recolherTodasDespesas">
                                    <i class="bi bi-arrows-collapse"></i>
                                    Recolher Todas
                                </button>
                            </div>
                        </div>
                        <div class="accordion accordion-flush accordion-danger" id="despesasAccordion">
                            @foreach (var despesa in Model.Despesas)
                            {
                                RenderLista(despesa, i, "danger", isCompacto, isDebug);

                                i++;
                            }
                        </div>
                        <div class="card-footer">
                        </div>
                    </div>
                </form>
            </div>
        </div>

        break;
}

@functions {
    private void RenderTabela(CategoriaApuradaModel categoria, int i, string subtleColor)
    {
        @if (categoria.Financas.Count > 0)
        {
            <tr>
                <td colspan="2">
                    <div class="accordion accordion-@($"{subtleColor}")">
                        <div class="accordion-item border-@($"{subtleColor}")-subtle">
                            <h2 class="accordion-header">
                                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapse@($"{i}")" aria-expanded="true" aria-controls="panelsStayOpen-collapse@($"{i}")">
                                    Detalhes
                                </button>
                            </h2>
                            <div id="panelsStayOpen-collapse@($"{i}")" class="accordion-collapse collapse show">
                                <div class="accordion-body">
                                    Render(categoria.Financas, i);
                                </div>
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="2"></td>
            </tr>
        }
    }

    private void RenderLista(CategoriaApuradaModel categoria, int i, string subtleColor, bool isCompacto, bool isDebug)
    {
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapse@($"{i}")" aria-expanded="false" aria-controls="panelsStayOpen-collapse@($"{i}")">
                    <div class="flex-grow-1 text-overflow-ellipsis">
                        @* <span class="ordem text-end text-secondary">
                            @i.ToString().
                        </span> *@
                        <i class="bi bi-@(categoria.BiIcon)"></i>
                        @categoria.CategoriaNome
                    </div>
                    <div class="me-2 text-@($"{subtleColor}")">@Html.DisplayFor(model => categoria.Valor)</div>
                </button>
            </h2>
            <div id="panelsStayOpen-collapse@($"{i}")" class="accordion-collapse collapse">
                <div class="accordion-body">
                    @if (categoria.Financas.Count > 0)
                    {
                        Render(categoria.Financas, i, isCompacto, isDebug);
                    }
                    else
                    {
                        <div class="text-center">
                            <i class="bi bi-emoji-frown"></i>
                            <p>Nenhuma finança encontrada.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    private void Render(ICollection<FinancaPorCategoriaModel> financas, int i, bool isCompacto, bool isDebug)
    {
        <div class="table-responsive">
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th class="dia fixed">Dia</th>
                        <th>Descrição</th>
                        <th class="text-end valor fixed">Valor</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var financa in financas)
                    {
                        Render(financa, i, isCompacto, isDebug);
                    }
                </tbody>
            </table>

        </div>
    }

    private void Render(FinancaPorCategoriaModel financa, int i, bool isCompacto, bool isDebug)
    {
        <tr>
            <td class="fixed">@Html.DisplayFor(model => financa.Data)</td>
            <td>
                @if (financa.ContaNome != null)
                {
                    <span class="badge text-bg-secondary">@Html.DisplayFor(model => financa.Competencia)</span>
                    <span class="badge text-@(financa.ContaTipoId == TipoContaEnum.ContaCreditoAPagar ? "danger" : (financa.ContaTipoId == TipoContaEnum.ContaCreditoAReceber ? "primary": "dark"))-emphasis  bg-@(financa.ContaTipoId == TipoContaEnum.ContaCreditoAPagar ? "danger" : (financa.ContaTipoId == TipoContaEnum.ContaCreditoAReceber ? "primary": "dark"))-subtle border border-@(financa.ContaTipoId == TipoContaEnum.ContaCreditoAPagar ? "danger" : (financa.ContaTipoId == TipoContaEnum.ContaCreditoAReceber ? "primary": "dark"))">@financa.ContaNome</span>
                    @if (isDebug)
                    {

                    }
                }
                @if (!isCompacto)
                {
                    @financa.Descricao
                    @if (financa.EhPrevisao)
                    {
                        <i class="bi bi-stars"></i>
                    }
                    @if (financa.EhRecorrente)
                    {
                        <i class="bi bi-arrow-repeat"></i>
                    }
                    @if (financa.ValorOriginal != null)
                    {
                        <span class="badge text-bg-light">@Html.DisplayFor(model => financa.ValorOriginal)</span>
                    }
                }
            </td>
            @if (financa.EhPrevisao)
            {
                if (financa.TipoFinancaId == TipoFinancaEnum.Despesa)
                {
                    if (financa.ValorExcedente == null)
                    {
                        <td class="text-end fixed">
                            @Html.DisplayFor(model => financa.Valor)
                            <i class="bi bi-hourglass"></i>
                        </td>
                    }
                    else if (financa.ValorExcedente > 0)
                    {
                        <td class="text-end text-danger fw-bold fixed">
                            (+@Html.DisplayFor(model => financa.ValorExcedente))
                            <i class="bi bi-exclamation-circle"></i>
                        </td>
                    }
                    else
                    {
                        <td class="text-end text-success fw-bold fixed">
                            (@Html.DisplayFor(model => financa.ValorExcedente))
                            <i class="bi bi-check-circle"></i>
                        </td>
                    }
                }
            }
            else
            {
                <td class="text-end fixed">
                    @Html.DisplayFor(model => financa.Valor)
                    <i class="bi bi-dot"></i>
                </td>
            }
        </tr>
        @if (isCompacto)
        {
            <tr>
                <td colspan="3" class="text-overflow-ellipsis">
                    @financa.Descricao
                    @if (financa.EhPrevisao)
                    {
                        <i class="bi bi-stars"></i>
                    }
                    @if (financa.EhRecorrente)
                    {
                        <i class="bi bi-arrow-repeat"></i>
                    }
                    @if (financa.ValorOriginal != null)
                    {
                        <span class="badge text-bg-light">@Html.DisplayFor(model => financa.ValorOriginal)</span>
                    }
                </td>
            </tr>
        }
    }
}

@section scripts {
    <script>
        $(document).ready(function(){
            $('#expandirTodasReceitas').on('click', function(){
                $('#receitasAccordion .collapse').collapse('show');
            });

            $('#recolherTodasReceitas').on('click', function(){
                $('#receitasAccordion .collapse').collapse('hide');
            });

            $('#expandirTodasDespesas').on('click', function(){
                $('#despesasAccordion .collapse').collapse('show');
            });

            $('#recolherTodasDespesas').on('click', function(){
                $('#despesasAccordion .collapse').collapse('hide');
            });
        });
    </script>
}
